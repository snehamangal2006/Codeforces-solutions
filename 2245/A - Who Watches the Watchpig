#include <iostream>
#include <string>
#include <vector>
 
using namespace std;
 
void solve() {
    int n, k;
    cin >> n >> k;
    string s;
    cin >> s;
 
    // If prefix and suffix requirements overlap, it's impossible
    if (2 * k > n) {
        cout << -1 << "
";
        return;
    }
 
    int flips = 0;
 
    // First k elements must be 'R'
    for (int i = 0; i < k; ++i) {
        if (s[i] != 'R') {
            flips++;
        }
    }
 
    // Last k elements must be 'L'
    for (int i = n - k; i < n; ++i) {
        if (s[i] != 'L') {
            flips++;
        }
    }
 
    cout << flips << "
";
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
 
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
 
    return 0;
}